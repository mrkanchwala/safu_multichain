# Yield vault setup config. Copy, fill in, pass to scripts/deploy/setup_vault.sh.
# Every value is required (POOL / RESERVE_* only for the rounding-reserve step).
NETWORK=safu-mainnet

# The pool's asset, and DeFindex's mainnet addresses (verified 2026-09-29 against DeFindex's
# public/mainnet.contracts.json AND on-chain; the script re-checks the strategy's asset).
ASSET_TOKEN=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75   # Circle USDC SAC
DEFINDEX_FACTORY=CDKFHFJIET3A73A2YN4KV7NSV32S6YGQMUFH3DNJXLBWL4SKEGVRNFKI
BLEND_STRATEGY=CDB2WMKQQNVZMEBY7Q7GZ5C7E7IAFSNMZ7GGVD6WKTCEWK7XOIAVZSAP
STRATEGY_NAME=usdc_blend_autocompound_fixed_strategy
SOROSWAP_ROUTER=CAG5LRYQ5JVEUI5TEID72EYOVX44TTUJT5BQR2J6J77FH65PCCFAJDDH   # required arg, never used

# Roles: manager / fee receiver / rebalance = ADMIN, emergency = GUARDIAN (same as the live vault).
ADMIN=GDHYJFXJWDWIPAMH7TM3YLCATRIKIFJITH3OXIMTAXUELKIQXYH5W356
GUARDIAN=GBON25AKIZETLWO7RM4M2GYR5OE5ZYQQ6V3H4DGZCMEUQ6OBY3TVBD5N
ADMIN_SOURCE=safu-v1-admin        # stellar-cli identity of ADMIN (signs the rebalance)

# Seeder: a wallet that is NOT the pool. Its first deposit carries DeFindex's locked shares.
SEEDER=safu-vault-seeder          # stellar-cli identity, holds SEED_AMOUNT of the asset
SEED_AMOUNT=100000                # 0.01 USDC at 7 decimals

VAULT_NAME="SAFU Protection"
VAULT_SYMBOL=SAFUUSDC

# Rounding reserve (B1 rule 20). Leave POOL empty to skip; one-way, nothing takes it back.
POOL=
RESERVE_FUNDER=safu-v1-admin
RESERVE_AMOUNT=100000             # 0.01 USDC: ten times the most one payment may draw
